    <!--BANNIÈRE CTA FINALE AVEC INTERACTION SIMPLE-->
    <section class="w-full bg-primary text-on-primary py-space-3xl relative overflow-hidden">
      <div class="absolute inset-0 opacity-15">
        <div
          class="w-full h-full bg-cover bg-center"
          data-alt="Blueprint blueprints and modern steel structure background with technical geometrical drawing lines and architectural measurements"
          style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCoF0kitWhT6DduAo69lfLpfuhsd0ti89LS7cHCSFszsIqT5dRvaT9_4QcIAG5gyxlTXUhTp5DZqDFeYQwGUc5GCluPBuWnVsurCF0-WhiwWxWrfXmb90Rfjw1SOSlGZd1nBnKMKMma4fzS0C0Q5jelr65K5qKKfKBZ3czNcjDuSSuqk8KVqUFESEPTMLD4nUT0rGE5QaSskJqzDxINbyZk25r_QD0vhmsilkFI9mg87x5YIiJUSKvf')"
        ></div>
      </div>
      <div class="relative z-10 max-w-[1320px] mx-auto px-gutter-desktop">
        <div
          class="bg-surface-container-high/10 backdrop-blur-md rounded-2xl p-space-xl lg:p-space-2xl shadow-2xl"
        >
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-center">
            <div class="lg:col-span-8 flex flex-col">
              <span
                class="font-label-technical text-label-technical text-secondary-container uppercase tracking-widest mb-space-xs"
              >
                Concrétisez votre vision
              </span>
              <h2
                class="font-headline-xl text-display-hero-mobile lg:text-headline-xl text-on-primary uppercase tracking-tight mb-space-sm"
              >
                Prêt à lancer votre prochain chantier d'envergure ?
              </h2>
              <p class="font-body-lg text-body-lg text-outline-variant max-w-2xl leading-relaxed">
                Contactez nos ingénieurs dès aujourd'hui pour une étude de faisabilité technique sans engagement, une analyse de plan ou un devis chiffré poste par poste.
              </p>
              <div class="flex flex-wrap items-center gap-space-lg mt-space-xl">
                <div class="flex items-center gap-space-xs text-on-primary">
                  <span class="material-symbols-outlined text-secondary-container">schedule</span>
                  <span class="font-label-ui text-label-ui">Retour sous 48h ouvrées</span>
                </div>
                <div class="flex items-center gap-space-xs text-on-primary">
                  <span class="material-symbols-outlined text-secondary-container">shield</span>
                  <span class="font-label-ui text-label-ui">Assurance Décennale AXA</span>
                </div>
                <div class="flex items-center gap-space-xs text-on-primary">
                  <span class="material-symbols-outlined text-secondary-container">handshake</span>
                  <span class="font-label-ui text-label-ui">
                    Accompagnement administratif complet
                  </span>
                </div>
              </div>
            </div>
            <div
              class="lg:col-span-4 flex flex-col gap-space-sm bg-surface-container-lowest text-on-surface p-space-lg rounded-xl shadow-xl"
              x-data="{ sent: false }"
            >
              <h3 class="font-headline-sm text-headline-sm text-primary uppercase">
                Demande Express
              </h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant">
                Laissez-nous vos coordonnées, un chef de projet NOVABAT vous rappelle :
              </p>
              <form
                class="flex flex-col gap-space-xs mt-space-xs"
                id="express-contact-form"
                x-show="!sent"
                @submit.prevent="sent = true"
              >
                <div>
                  <label
                    class="font-label-technical text-label-technical text-on-surface-variant block mb-1"
                  >
                    Votre Nom &amp; Société
                  </label>
                  <input
                    class="w-full px-space-md py-2 bg-surface-container-low rounded-lg font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary"
                    name="name"
                    placeholder="Ex: Jean Dupont (Cabinet Archi)"
                    required
                    type="text"
                  />
                </div>
                <div>
                  <label
                    class="font-label-technical text-label-technical text-on-surface-variant block mb-1"
                  >
                    Téléphone Direct
                  </label>
                  <input
                    class="w-full px-space-md py-2 bg-surface-container-low rounded-lg font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary"
                    name="phone"
                    placeholder="+33 6 00 00 00 00"
                    required
                    type="tel"
                  />
                </div>
                <div>
                  <label
                    class="font-label-technical text-label-technical text-on-surface-variant block mb-1"
                  >
                    Type de Projet
                  </label>
                  <select
                    class="w-full px-space-md py-2 bg-surface-container-low rounded-lg font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-secondary"
                    name="project_type"
                  >
                    <option>Construction Neuve (Résidentiel)</option>
                    <option>Rénovation Lourde / Réhabilitation</option>
                    <option>Surélévation / Extension</option>
                    <option>Bâtiment Professionnel / Tertiaire</option>
                    <option>Autre prestation d'ingénierie</option>
                  </select>
                </div>
                <button
                  class="w-full mt-space-xs py-space-sm bg-secondary hover:bg-secondary-container text-on-secondary rounded-lg font-label-ui text-label-ui uppercase tracking-wider transition-colors flex items-center justify-center gap-space-xs"
                  type="submit"
                >
                  Être Recontacté en Priorité
                  <span class="material-symbols-outlined text-[18px]">phone_forwarded</span>
                </button>
              </form>
              <div
                class="flex flex-col items-center text-center p-space-md bg-surface-container-low rounded-lg"
                id="express-success"
                x-cloak
                x-show="sent"
              >
                <span class="material-symbols-outlined text-secondary text-[40px] mb-space-xs">
                  check_circle
                </span>
                <span class="font-headline-sm text-headline-sm text-on-surface">
                  Demande transmise
                </span>
                <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
                  Notre bureau d'études vous contactera sous 24 heures.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
@end
