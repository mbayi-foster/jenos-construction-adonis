@layout()
  <div class="flex flex-col w-full">
    <!--HERO IMMERSIF STYLE TECTONIQUE ARCHITECTURAL-->
    <section class="relative w-full overflow-hidden bg-primary text-on-primary">
      <div class="absolute inset-0 z-0 opacity-25">
        <div
          class="w-full h-full bg-cover bg-center mix-blend-luminosity scale-105 transform"
          data-alt="Modern architectural construction site in Paris featuring sharp reinforced concrete structural frames, sleek glass facades, warm ambient morning light, crisp technical geometric lines, hyper-realistic architectural photography with deep slate tones and warm terracotta construction elements"
          style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAsxoXJL8RN6UEDBgXfVBXKCqCjd6wqyCEkFmPTCmM3zJUVLT57IrQ2wIF06v5OYGAqkfuIy14W0KCqBW9UQF7XOeAl5HTStSpAARW-b362HzEbv9dQ0HxPgX9x4ZNGLkH9U2L5ULVObq_nQ2YhI1gmkl_I3SLjQ1rKaEgpJUHuy0YfW89FROM1oN2XAeIvgaTyYkIghlq7F0tlBiuAbfHUb5cYq-2eGzPXWBIzkxrOmgoj6VutRSxh')"
        ></div>
      </div>
      <div
        class="absolute inset-0 bg-linear-to-r from-primary via-primary/90 to-primary/40 z-0"
      ></div>
      <div
        class="relative z-10 max-w-330 mx-auto px-gutter-desktop py-space-3xl flex flex-col justify-between min-h-[580px]"
      >
        <div class="flex flex-wrap items-center gap-space-sm mb-space-xl">
          <span
            class="inline-flex items-center gap-space-xs px-space-sm py-1 bg-surface-container-lowest/10 backdrop-blur-md rounded-lg font-label-technical text-label-technical text-primary-fixed uppercase tracking-wider"
          >
            <span class="w-2 h-2 rounded-full bg-secondary-container animate-pulse"></span>
            Ingénierie &amp; Bâtiment Île-de-France
          </span>
          <span
            class="font-label-technical text-label-technical text-outline-variant hidden sm:inline-block"
          >
            /
          </span>
          <span
            class="font-label-technical text-label-technical text-surface-container-highest tracking-widest uppercase"
          >
            Certifié Qualibat • Garantie Décennale AXA
          </span>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-end">
          <div class="lg:col-span-8 flex flex-col">
            <h1
              class="font-display-hero text-display-hero-mobile sm:text-display-hero text-on-primary leading-none uppercase tracking-tight mb-space-md"
            >
              
              
              
               Construisons aujourd'hui les villes de demain.


              <br class="hidden sm:block" />
              {{--
                <span class="text-secondary-container">Précision</span>
                &amp; Excellence
              --}}
            </h1>
            <p
              class="font-body-lg text-body-lg text-outline-variant max-w-2xl leading-relaxed mb-space-xl"
            >
              Chez JENOS CONSTRUCTION, nous croyons que la construction est plus qu'un simple assemblage de matériaux. C'est un art, une passion, et une responsabilité envers les générations futures.
            </p>
            <div class="flex flex-wrap items-center gap-space-md">
              <a
                class="inline-flex items-center justify-center px-space-xl py-4 bg-secondary hover:bg-secondary-container text-on-secondary rounded-lg font-label-ui text-label-ui uppercase tracking-wider transition-all duration-200 shadow-lg shadow-secondary/20"
                data-path="devis-gratuit"
                href="#"
              >
                Demander une étude gratuite
                <span class="material-symbols-outlined ml-space-xs text-[18px]">arrow_forward</span>
              </a>
              <a
                class="inline-flex items-center justify-center px-space-lg py-4 bg-surface-container-lowest/10 hover:bg-surface-container-lowest/20 text-on-primary rounded-lg font-label-ui text-label-ui uppercase tracking-wider backdrop-blur-sm transition-all duration-200"
                data-path="nos-realisations"
                href="#"
              >
                Découvrir nos réalisations
              </a>
            </div>
          </div>
          <div class="lg:col-span-4 flex flex-col justify-end">
            <div
              class="bg-surface-container-high/10 backdrop-blur-xl p-space-lg rounded-xl shadow-2xl flex flex-col gap-space-md"
            >
              <div class="flex items-center justify-between pb-space-xs">
                <span
                  class="font-label-technical text-label-technical uppercase text-outline-variant"
                >
                  Garanties &amp; Certifications
                </span>
                <span class="material-symbols-outlined text-secondary-container">verified</span>
              </div>
              <div class="flex items-center gap-space-md">
                <div class="flex -space-x-2 overflow-hidden">
                  <div
                    class="h-8 w-8 rounded-full bg-secondary-container flex items-center justify-center text-on-secondary font-headline-sm text-[12px]"
                  >
                    18
                  </div>
                  <div
                    class="h-8 w-8 rounded-full bg-surface-container-lowest flex items-center justify-center text-primary font-headline-sm text-[12px]"
                  >
                    380
                  </div>
                  <div
                    class="h-8 w-8 rounded-full bg-tertiary-container flex items-center justify-center text-tertiary-fixed font-headline-sm text-[12px]"
                  >
                    RGE
                  </div>
                </div>
                <div class="flex flex-col">
                  <span class="font-label-ui text-label-ui text-on-primary">
                    Norme RE2020 &amp; HQE
                  </span>
                  <span class="font-caption text-caption text-outline-variant">
                    +380 chantiers livrés sous garantie décennale
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div
          class="mt-space-2xl pt-space-md flex flex-wrap items-center justify-between gap-space-md font-label-technical text-label-technical text-outline-variant"
        >
          <span class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
            GROS ŒUVRE • SURÉLÉVATION
          </span>
          <span class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
            RÉHABILITATION THERMIQUE LOURDE
          </span>
          <span class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
            MAÎTRISE D'ŒUVRE INTÉGRÉE
          </span>
          <span class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
            PARIS &amp; ÎLE-DE-FRANCE
          </span>
        </div>
      </div>
    </section>
    <!--KEY METRICS GRID-->
    <section class="w-full bg-surface-container-lowest py-space-xl">
      <div class="max-w-[1320px] mx-auto px-gutter-desktop">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-space-lg">
          <div
            class="flex flex-col p-space-lg rounded-xl bg-surface-container-low transition-transform duration-200 hover:-translate-y-1"
          >
            <div class="w-8 h-1 bg-secondary-container mb-space-sm"></div>
            <div class="flex items-baseline gap-1">
              <span class="font-headline-xl text-headline-xl text-primary font-bold">18</span>
              <span class="font-headline-sm text-headline-sm text-secondary font-bold">Ans</span>
            </div>
            <span class="font-headline-sm text-headline-sm text-on-surface mt-1">
              Expérience Solide
            </span>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">
              Sur chantiers parisiens et franciliens complexes
            </p>
          </div>
          <div
            class="flex flex-col p-space-lg rounded-xl bg-surface-container-low transition-transform duration-200 hover:-translate-y-1"
          >
            <div class="w-8 h-1 bg-secondary-container mb-space-sm"></div>
            <div class="flex items-baseline gap-1">
              <span class="font-headline-xl text-headline-xl text-primary font-bold">380+</span>
            </div>
            <span class="font-headline-sm text-headline-sm text-on-surface mt-1">
              Chantiers Réalisés
            </span>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">
              Villas d'exception, immeubles et sièges d'entreprises
            </p>
          </div>
          <div
            class="flex flex-col p-space-lg rounded-xl bg-surface-container-low transition-transform duration-200 hover:-translate-y-1"
          >
            <div class="w-8 h-1 bg-secondary-container mb-space-sm"></div>
            <div class="flex items-baseline gap-1">
              <span class="font-headline-xl text-headline-xl text-primary font-bold">98</span>
              <span class="font-headline-sm text-headline-sm text-secondary font-bold">%</span>
            </div>
            <span class="font-headline-sm text-headline-sm text-on-surface mt-1">
              Taux de Satisfaction
            </span>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">
              Délais tenus, transparence budgétaire absolue
            </p>
          </div>
          <div
            class="flex flex-col p-space-lg rounded-xl bg-surface-container-low transition-transform duration-200 hover:-translate-y-1"
          >
            <div class="w-8 h-1 bg-secondary-container mb-space-sm"></div>
            <div class="flex items-baseline gap-1">
              <span class="font-headline-xl text-headline-xl text-primary font-bold">45</span>
              <span class="font-headline-sm text-headline-sm text-secondary font-bold">
                Compagnons
              </span>
            </div>
            <span class="font-headline-sm text-headline-sm text-on-surface mt-1">
              Experts Certifiés
            </span>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">
              Ingénieurs béton, conducteurs de travaux &amp; artisans d'art
            </p>
          </div>
        </div>
      </div>
    </section>
    <!--VISION & MISSIONS - ASYMMETRIC SECTION-->
    <section class="w-full bg-surface py-space-3xl">
      <div class="max-w-[1320px] mx-auto px-gutter-desktop">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-2xl items-center">
          <!--Text Content-->
          <div class="lg:col-span-6 flex flex-col">
            <div
              class="flex items-center gap-space-xs font-label-technical text-label-technical text-secondary uppercase tracking-widest mb-space-sm"
            >
              <span class="material-symbols-outlined text-[16px]">architecture</span>
              Philosophie &amp; Rigueur Opérationnelle
            </div>
            <h2
              class="font-headline-xl text-headline-xl-mobile md:text-headline-xl text-primary uppercase tracking-tight mb-space-md"
            >
              Construisons aujourd'hui les villes de demain.
            </h2>
            <p
              class="font-body-lg text-body-lg text-on-surface-variant mb-space-xl leading-relaxed"
            >
              Créée par un passionné d’architecture et de développement durable, l’entreprise a vu le jour avec la conviction que chaque ouvrage doit être plus qu’un simple bâtiment : il doit être un symbole de qualité, de fiabilité et d’impact positif dans la communauté.Dès ses débuts,
              <b>JENOS CONSTRUCTION</b>
              s’est démarquée par son approche intégrée : combiner savoir-faire technique, innovation, et respect des délais pour offrir des infrastructures solides et esthétiques, adaptées aux réalités locales.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-lg">
              <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm">
                <div
                  class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-secondary mb-space-sm"
                >
                  <span class="material-symbols-outlined">eco</span>
                </div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface uppercase mb-space-xs">
                  Notre Vision
                </h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                  JENOS CONSTRUCTION est née d’une vision simple mais ambitieuse "Bâtir autrement".
                </p>
              </div>
              <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm">
                <div
                  class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-secondary mb-space-sm"
                >
                  <span class="material-symbols-outlined">assignment_turned_in</span>
                </div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface uppercase mb-space-xs">
                  Nos Missions
                </h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                  Pilotage clé en main, gestion rigoureuse des plannings sans dépassement budgétaire, coordination proactive des corps d'état et sécurité absolue sur chantier.
                </p>
              </div>
            </div>
            <div class="mt-space-xl flex items-center gap-space-lg">
              <div
                class="flex items-center gap-space-xs font-label-technical text-label-technical text-on-surface"
              >
                <span class="material-symbols-outlined text-secondary text-[20px]">
                  check_circle
                </span>
                Contrôles Bureau Veritas &amp; Apave
              </div>
              <div
                class="flex items-center gap-space-xs font-label-technical text-label-technical text-on-surface"
              >
                <span class="material-symbols-outlined text-secondary text-[20px]">
                  check_circle
                </span>
                Audit Thermique RGE
              </div>
            </div>
          </div>
          <!--Visual / Graphic / Architecture Slate-->
          <div class="lg:col-span-6 relative">
            <div
              class="relative w-full h-120 rounded-xl overflow-hidden shadow-2xl bg-surface-container-high"
            >
              <div
                class="w-full h-full bg-cover bg-center"
                data-alt="Interior architectural concrete and timber structure under construction with sunlight streaming through large geometric panoramic glass bays, architects reviewing blueprints in crisp high-contrast lighting"
                style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCRbajcAOcb4gVMyK09a5r08y1oTO31KVAEKLFM-kEzPiaJn6W5XdfmMh4xtaKEKDvBdxCRY1dqQcn1vdMgyosCjC-XcribsX0PPlGuFB8WwBSTjZwEq3lGMjJJCyf0tT9JFFNM0kvBRC6iTiyeDW4I9gZIOZmd2Cd7mgEqeSLnSj0u8DOMKP0Hrno7s43_l8heIZgnpqT3c_odFHCFQ2t_BV5Tkl5yz05B4MUe0z0PgdnYfYeoSjPc')"
              ></div>
              <div
                class="absolute inset-0 bg-linear-to-t from-primary/80 via-transparent to-transparent"
              ></div>
              <div
                class="absolute bottom-6 left-6 right-6 p-space-md bg-surface-container-lowest/95 backdrop-blur-md rounded-lg shadow-lg"
              >
                <div class="flex items-center justify-between">
                  <div class="flex flex-col">
                    <span
                      class="font-label-technical text-label-technical text-secondary uppercase font-semibold"
                    >
                      Bureau d'études NOVABAT
                    </span>
                    <span class="font-headline-sm text-headline-sm text-on-surface">
                      Modélisation BIM &amp; Calcul Structurel
                    </span>
                  </div>
                  <div
                    class="h-10 w-10 rounded-full bg-primary text-on-primary flex items-center justify-center"
                  >
                    <span class="material-symbols-outlined text-[20px]">layers</span>
                  </div>
                </div>
              </div>
            </div>
            <!--Decorative offset metric box-->
            <div
              class="hidden sm:flex flex-col absolute -top-6 -right-6 p-space-md bg-secondary text-on-secondary rounded-lg shadow-xl max-w-[200px]"
            >
              <span
                class="font-label-technical text-label-technical uppercase tracking-wider opacity-80"
              >
                Indice Zéro Retard
              </span>
              <span class="font-headline-md text-headline-md font-bold mt-1">99.2 %</span>
              <span class="font-caption text-caption mt-1 opacity-90">
                Livraisons contractuelles conformes sur l'exercice
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!--NOS DOMAINES D'INTERVENTION / EXPERTISES-->
    <section class="w-full bg-surface-container-low py-space-3xl">
      <div class="max-w-[1320px] mx-auto px-gutter-desktop">
        <div
          class="flex flex-col md:flex-row md:items-end justify-between mb-space-2xl gap-space-md"
        >
          <div>
            <div
              class="flex items-center gap-space-xs font-label-technical text-label-technical text-secondary uppercase tracking-widest mb-space-xs"
            >
              <span class="material-symbols-outlined text-[16px]">domain</span>
              Nos Compétences Spécifiques
            </div>
            <h2
              class="font-headline-xl text-headline-xl-mobile md:text-headline-xl text-primary uppercase tracking-tight"
            >
              Champs d'Expertise &amp; Maîtrise d'Œuvre
            </h2>
          </div>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-md">
            Chaque projet est traité comme une pièce d'ingénierie unique. Nos équipes pluridisciplinaires interviennent à chaque stade de votre opération.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-space-lg">
          <!--Service 1-->
          <div
            class="group bg-surface-container-lowest p-space-xl rounded-xl shadow-sm transition-all duration-300 hover:shadow-xl hover:-translate-y-1 flex flex-col justify-between"
          >
            <div>
              <div
                class="w-14 h-14 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:bg-secondary group-hover:text-on-secondary transition-colors duration-300 mb-space-lg"
              >
                <span class="material-symbols-outlined text-[30px]">apartment</span>
              </div>
              <span
                class="font-label-technical text-label-technical text-secondary uppercase font-semibold"
              >
                01 • Neuf Résidentiel &amp; Tertiaire
              </span>
              <h3
                class="font-headline-sm text-headline-sm text-on-surface uppercase mt-space-xs mb-space-sm group-hover:text-secondary transition-colors"
              >
                Construction Neuve
              </h3>
              <p
                class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-lg"
              >
                Édification de programmes d'immeubles, bureaux et villas contemporaines de grand standing. Respect des labels HQE, BREEAM et conformité RE2020.
              </p>
            </div>
            <ul
              class="flex flex-col gap-space-xs font-label-technical text-label-technical text-on-surface-variant pt-space-md bg-surface-container-low/50 p-space-md rounded-lg"
            >
              <li class="flex items-center gap-2">
                <span class="text-secondary font-bold">•</span>
                Fondations profondes &amp; pieux
              </li>
              <li class="flex items-center gap-2">
                <span class="text-secondary font-bold">•</span>
                Ossatures béton armé &amp; mixtes bois-acier
              </li>
              <li class="flex items-center gap-2">
                <span class="text-secondary font-bold">•</span>
                Enveloppe thermique haute performance
              </li>
            </ul>
          </div>
          <!--Service 2-->
          <div
            class="group bg-surface-container-lowest p-space-xl rounded-xl shadow-sm transition-all duration-300 hover:shadow-xl hover:-translate-y-1 flex flex-col justify-between"
          >
            <div>
              <div
                class="w-14 h-14 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:bg-secondary group-hover:text-on-secondary transition-colors duration-300 mb-space-lg"
              >
                <span class="material-symbols-outlined text-[30px]">foundation</span>
              </div>
              <span
                class="font-label-technical text-label-technical text-secondary uppercase font-semibold"
              >
                02 • Reprise sous-œuvre &amp; Structure
              </span>
              <h3
                class="font-headline-sm text-headline-sm text-on-surface uppercase mt-space-xs mb-space-sm group-hover:text-secondary transition-colors"
              >
                Gros Œuvre &amp; Maçonnerie
              </h3>
              <p
                class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-lg"
              >
                Expertise chirurgicale en création de trémies, ouverture de murs porteurs par profilés métalliques IPN/HEA et consolidation structurelle en sous-sol.
              </p>
            </div>
            <ul
              class="flex flex-col gap-space-xs font-label-technical text-label-technical text-on-surface-variant pt-space-md bg-surface-container-low/50 p-space-md rounded-lg"
            >
              <li class="flex items-center gap-2">
                <span class="text-secondary font-bold">•</span>
                Calculs de descente de charges
              </li>
              <li class="flex items-center gap-2">
                <span class="text-secondary font-bold">•</span>
                Reprise en sous-œuvre &amp; micropieux
              </li>
              <li class="flex items-center gap-2">
                <span class="text-secondary font-bold">•</span>
                Chape fluide &amp; dallage industriel
              </li>
            </ul>
          </div>
          <!--Service 3-->
          <div
            class="group bg-surface-container-lowest p-space-xl rounded-xl shadow-sm transition-all duration-300 hover:shadow-xl hover:-translate-y-1 flex flex-col justify-between"
          >
            <div>
              <div
                class="w-14 h-14 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:bg-secondary group-hover:text-on-secondary transition-colors duration-300 mb-space-lg"
              >
                <span class="material-symbols-outlined text-[30px]">history_edu</span>
              </div>
              <span
                class="font-label-technical text-label-technical text-secondary uppercase font-semibold"
              >
                03 • Réhabilitation Complète
              </span>
              <h3
                class="font-headline-sm text-headline-sm text-on-surface uppercase mt-space-xs mb-space-sm group-hover:text-secondary transition-colors"
              >
                Rénovation Lourde
              </h3>
              <p
                class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-lg"
              >
                Métamorphose d'immeubles haussmanniens, réhabilitation de manufactures industrielles en lofts ou requalification d'espaces professionnels tertiaires.
              </p>
            </div>
            <ul
              class="flex flex-col gap-space-xs font-label-technical text-label-technical text-on-surface-variant pt-space-md bg-surface-container-low/50 p-space-md rounded-lg"
            >
              <li class="flex items-center gap-2">
                <span class="text-secondary font-bold">•</span>
                Désamiantage &amp; déplombage encadré
              </li>
              <li class="flex items-center gap-2">
                <span class="text-secondary font-bold">•</span>
                Réfection totale de planchers anciens
              </li>
              <li class="flex items-center gap-2">
                <span class="text-secondary font-bold">•</span>
                Mise aux normes ERP et accessibilité PMR
              </li>
            </ul>
          </div>
          <!--Service 4-->
          <div
            class="group bg-surface-container-lowest p-space-xl rounded-xl shadow-sm transition-all duration-300 hover:shadow-xl hover:-translate-y-1 flex flex-col justify-between"
          >
            <div>
              <div
                class="w-14 h-14 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:bg-secondary group-hover:text-on-secondary transition-colors duration-300 mb-space-lg"
              >
                <span class="material-symbols-outlined text-[30px]">height</span>
              </div>
              <span
                class="font-label-technical text-label-technical text-secondary uppercase font-semibold"
              >
                04 • Densification Urbaine
              </span>
              <h3
                class="font-headline-sm text-headline-sm text-on-surface uppercase mt-space-xs mb-space-sm group-hover:text-secondary transition-colors"
              >
                Surélévation &amp; Extension
              </h3>
              <p
                class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-lg"
              >
                Valorisation maximale du foncier urbain en ajoutant des niveaux en ossature bois ou métal allégé, sans interruption d'usage des étages inférieurs.
              </p>
            </div>
